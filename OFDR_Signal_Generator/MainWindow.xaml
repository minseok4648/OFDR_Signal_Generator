<Window x:Class="OFDR_Signal_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OFDR_Signal_Generator.Controls"
        mc:Ignorable="d"
        Title="OFDR 독립 채널 분석 도구"
        Height="940" Width="1600" MinHeight="820" MinWidth="1320"
        Background="#FFF3F6FA">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="#FFD9E2EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Background" Value="#FF0F766E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF0F766E" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF334155" />
            <Setter Property="Margin" Value="0,4,0,5" />
        </Style>
        <Style x:Key="PlotTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF0F172A" />
            <Setter Property="Margin" Value="4,2,4,6" />
        </Style>
    </Window.Resources>

    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Margin="8,8,8,0" Padding="10" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
      <StackPanel DataContext="{Binding Unified}">
        <Grid IsEnabled="{Binding ControlsEnabled}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
          <TextBlock Text="Ref" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Text="{Binding ReferencePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="UnifiedReferencePath" Margin="0,0,6,6"/>
          <Button Grid.Column="2" Content="Ref 선택" Command="{Binding BrowseReferenceCommand}"/>
          <TextBlock Grid.Column="3" Text="Signal" VerticalAlignment="Center"/>
          <TextBox Grid.Column="4" Text="{Binding SignalPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="UnifiedSignalPath" Margin="0,0,6,6"/>
          <Button Grid.Column="5" Content="Sig 선택" Command="{Binding BrowseSignalCommand}"/>
        </Grid>
        <WrapPanel>
          <Button Content="전체 분석 실행" Command="{Binding RunCommand}" AutomationProperties.AutomationId="UnifiedRun"/>
          <Button Content="취소" Command="{Binding CancelCommand}"/>
          <Button Content="현재 선택 가져오기" Command="{Binding UseCurrentSelectionCommand}"/>
          <Button Content="결과 폴더" Command="{Binding OpenResultsCommand}"/>
          <Button Content="기존 결과 보기" Command="{Binding ShowGeneralCommand}"/>
          <Button Content="Reflectogram 보기" Command="{Binding ShowReflectogramCommand}"/>
          <Button Content="ZNCC 보기" Command="{Binding ShowZnccCommand}"/>
        </WrapPanel>
        <TextBlock Text="{Binding StageSummary}" FontWeight="SemiBold" Foreground="#0F766E" AutomationProperties.AutomationId="UnifiedStages"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" MaxHeight="42" AutomationProperties.AutomationId="UnifiedStatus"/>
        <TextBlock Text="Ref·Signal 두 취득 · 진단 실행(QC 미통과 표시 유지) · 기존: 전체 mask 후 일반 처리 / Reflectogram: 정상 구간 전력 평균 / ZNCC: 취득별 최장 정상 구간 B/C. 세부 설정은 각 탭을 사용합니다." TextWrapping="Wrap" Foreground="#64748B" FontSize="10"/>
      </StackPanel>
    </Border>
    <TabControl Grid.Row="1" x:Name="WorkspaceTabs" Margin="8" SelectedIndex="{Binding WorkspaceSelectedTab}">
        <TabItem Header="전체 신호 / Mode hop" IsEnabled="{Binding LegacyControlsEnabled}">
            <controls:ModeHopPreviewView DataContext="{Binding ModeHopPreview}" />
        </TabItem>
        <TabItem Header="기존 OFDR 분석" IsEnabled="{Binding LegacyControlsEnabled}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4,0,4,12">
                <TextBlock Text="OFDR 독립 채널 분석" FontSize="25" FontWeight="Bold" Foreground="#FF0F172A" />
                <Button Content="기존 CH1/CH2/CH3 파일 입력으로 전환" Command="{Binding UseLegacyInputsCommand}" Margin="0,5,0,0"/>
                <TextBlock Margin="0,6,0,0" Foreground="#FF475569" TextWrapping="Wrap"
                           Text="Ref와 Sig가 동시 취득한 각 보조간섭계로 독립 K-linearization한 뒤 Rayleigh spectral shift를 계산합니다." />
            </StackPanel>

            <TabControl Grid.Row="1" Margin="0,0,0,8" AutomationProperties.AutomationId="AlgorithmInputTabs">
                <TabItem Header="데이터 불러오기">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <Button Content="저장된 진단 CSV와 원본 CH4로 네 입력 설정" Command="{Binding UseSavedCsvFilesCommand}"/>
                            <CheckBox Content="저장된 진단 CSV 입력 (보조 CH3 / 측정 CH4)" IsChecked="{Binding UseSavedCsvFileInputs}" Margin="0,0,0,8"/>
                            <CheckBox Content="현재 상태 확인용 진단 실행 (QC 불합격 표시 유지)" IsChecked="{Binding AllowFailedPhaseQcForDiagnostics}" Margin="0,0,0,8" AutomationProperties.AutomationId="DiagnosticExecution"/>
                            <TextBlock Text="진단 CSV는 보조간섭계입니다. 측정 입력에는 CH4가 있는 원본 또는 통합 CSV를 선택합니다. SourceIndex를 사용해 같은 샘플을 맞춥니다." TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,8"/>
                            <GroupBox Header="{Binding ReferenceAuxiliaryLabel}">
                                <StackPanel>
                                    <TextBox Text="{Binding AuxiliaryPath}" IsReadOnly="True" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="파일 선택..." Command="{Binding BrowseAuxiliaryCommand}" />
                                        <Button Content="채널 CSV 변환" Command="{Binding ConvertAuxiliaryCommand}" Background="#FF0369A1" BorderBrush="#FF0369A1" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{Binding SignalAuxiliaryLabel}">
                                <StackPanel>
                                    <TextBox Text="{Binding SignalAuxiliaryPath}" IsReadOnly="True" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="파일 선택..." Command="{Binding BrowseSignalAuxiliaryCommand}" />
                                        <Button Content="채널 CSV 변환" Command="{Binding ConvertSignalAuxiliaryCommand}" Background="#FF0369A1" BorderBrush="#FF0369A1" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Ref · 기준 측정 신호">
                                <StackPanel>
                                    <TextBox Text="{Binding ReferencePath}" IsReadOnly="True" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="파일 선택..." Command="{Binding BrowseReferenceCommand}" />
                                        <Button Content="채널 CSV 변환" Command="{Binding ConvertReferenceCommand}" Background="#FF0369A1" BorderBrush="#FF0369A1" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Sig · Ref와 동일한 측정 채널">
                                <StackPanel>
                                    <TextBox Text="{Binding SignalPath}" IsReadOnly="True" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="파일 선택..." Command="{Binding BrowseSignalCommand}" />
                                        <Button Content="채널 CSV 변환" Command="{Binding ConvertSignalCommand}" Background="#FF0369A1" BorderBrush="#FF0369A1" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="채널 CSV 출력 폴더">
                                <StackPanel>
                                    <TextBox Text="{Binding ChannelCsvOutputFolder}" />
                                    <Button Content="출력 폴더 선택..." Command="{Binding BrowseOutputFolderCommand}" HorizontalAlignment="Left" />
                                    <TextBlock Foreground="#FF64748B" TextWrapping="Wrap"
                                               Text="채널별 CSV 형식: Index, Time_s, Voltage_V. 기존 통합 CSV도 각 역할에 필요한 CH 열만 선택하여 읽을 수 있습니다." />
                                </StackPanel>
                            </GroupBox>

                            <Border Margin="6" Padding="10" CornerRadius="5" Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1">
                                <TextBlock Text="{Binding InputValidationText}" TextWrapping="Wrap" Foreground="#FF1E3A5F" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="알고리즘 설정">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <GroupBox Header="단계별 처리 비교 · 진단용" Margin="0,0,0,10" AutomationProperties.AutomationId="StageSelectionPanel">
                                <StackPanel Margin="6">
                                    <CheckBox Content="단계별 선택 사용 (문서 단계는 물리축·strain 환산 지원)" IsChecked="{Binding StageComparisonEnabled}" AutomationProperties.AutomationId="StageComparisonEnabled"/>
                                    <WrapPanel><Button Content="기존 단계 시작값" Command="{Binding StageLegacyPresetCommand}"/><Button Content="노트북 단계 시작값" Command="{Binding StageNotebookPresetCommand}" AutomationProperties.AutomationId="StageNotebookPreset"/></WrapPanel>
                                    <WrapPanel><Button Content="문서 B · 명목축" Command="{Binding DocumentNominalPresetCommand}" AutomationProperties.AutomationId="DocumentNominalPreset"/><Button Content="문서 C · AUX 위상" Command="{Binding DocumentPhasePresetCommand}" AutomationProperties.AutomationId="DocumentPhasePreset"/><Button Content="문서 D · 지연 추가" Command="{Binding DocumentDelayPresetCommand}" AutomationProperties.AutomationId="DocumentDelayPreset"/></WrapPanel>
                                    <Button Content="문서 분석 범위 0–15 m" Command="{Binding DocumentCableRangeCommand}" AutomationProperties.AutomationId="DocumentCableRange"/>
                                    <StackPanel IsEnabled="{Binding DataContext.StageComparisonEnabled, RelativeSource={RelativeSource AncestorType=GroupBox}}" DataContext="{Binding Stages}">
                                        <CheckBox Content="1. AUX 평균(DC) 제거" IsChecked="{Binding RemoveAuxiliaryMean}" AutomationProperties.AutomationId="StageRemoveAuxMean"/>
                                        <TextBlock Text="역행 위상 처리"/><ComboBox ItemsSource="{Binding PhaseOrders}" SelectedIndex="{Binding PhaseOrderIndex}" AutomationProperties.AutomationId="StagePhaseOrder"/>
                                        <TextBlock Text="2. Ref / Signal 위상 Grid"/><ComboBox ItemsSource="{Binding Grids}" SelectedIndex="{Binding GridIndex}" AutomationProperties.AutomationId="StageGrid"/>
                                        <TextBlock Text="3. Window 적용 위치"/><ComboBox ItemsSource="{Binding Windows}" SelectedIndex="{Binding WindowIndex}" AutomationProperties.AutomationId="StageWindow"/>
                                        <CheckBox Content="측정 신호 평균 제거 (전체 FFT 전)" IsChecked="{Binding RemoveMeasurementMean}"/>
                                        <CheckBox Content="국부 magnitude 평균 제거 (상관 전)" IsChecked="{Binding CenterLocalMagnitudes}"/>
                                        <TextBlock Text="출력 점수 / AUX offset / 측정 offset (sample)" TextWrapping="Wrap"/>
                                        <UniformGrid Columns="3"><TextBox Text="{Binding OutputSamples, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding AuxiliaryOffset, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding MeasurementOffset, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                        <TextBlock Text="최대 |lag| sample / 종료 FFT bin (0: 전체)" TextWrapping="Wrap"/>
                                        <UniformGrid Columns="2"><TextBox Text="{Binding MaximumLagSamples, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding StopFftBin, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                        <GroupBox Header="문서 비교 단계 · 각 옵션을 바꾸고 실행하여 비교">
                                            <StackPanel Margin="6">
                                                <CheckBox Content="문서 단계 확장 사용" IsChecked="{Binding Document.Enabled}" AutomationProperties.AutomationId="DocumentEnabled"/>
                                                <CheckBox Content="1. 연속 정상 구간 선택 (접합 경계 분리)" IsChecked="{Binding Document.SelectContinuousRange}" AutomationProperties.AutomationId="DocumentContinuous"/>
                                                <TextBlock Text="Ref / Signal 구간 번호 (-1: 각 취득의 최장 구간, 0부터 시작) / 최소 samples" TextWrapping="Wrap"/>
                                                <UniformGrid Columns="3"><TextBox Text="{Binding Document.ReferenceRangeIndex, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.SignalRangeIndex, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.MinimumRangeSamples, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                                <CheckBox Content="2. AUX 대역통과 필터" IsChecked="{Binding Document.BandpassEnabled}" AutomationProperties.AutomationId="DocumentBandpass"/>
                                                <CheckBox Content="샘플률에 맞춰 필터 상한 자동 제한 (요청≥Fs/2일 때 0.45×Fs)" IsChecked="{Binding Document.AutoLimitBandpass}" AutomationProperties.AutomationId="DocumentAutoBandpass"/>
                                                <TextBlock Text="하한 MHz / 상한 MHz / 양 끝 추가 제외 us"/>
                                                <UniformGrid Columns="3"><TextBox Text="{Binding Document.LowMHz, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DocumentLowMHz"/><TextBox Text="{Binding Document.HighMHz, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DocumentHighMHz"/><TextBox Text="{Binding Document.EdgeGuardMicroseconds, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                                <TextBlock Text="필터: 2차 Butterworth HP+LP 양방향, 반사 padding. 문서의 종류·차수는 미확인. guard와 Fs/2 조건을 검증하세요." TextWrapping="Wrap" Foreground="#475569"/>
                                                <TextBlock Text="3. AUX 지연 정렬 (양수: AUX 앞당김, 선형 fractional 보간)" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{Binding DocumentDelayModes}" SelectedIndex="{Binding DocumentDelayIndex}" AutomationProperties.AutomationId="DocumentDelayMode"/>
                                                <TextBlock Text="수동 us / 목표 OFDR 상대 거리 m / AUX 왕복 차등 지연 us"/>
                                                <UniformGrid Columns="3"><TextBox Text="{Binding Document.DelayMicroseconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DocumentDelayUs"/><TextBox Text="{Binding Document.ReflectionDistanceMeters, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.AuxiliaryDelayMicroseconds, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                                <CheckBox Content="4. 명목 sweep 축 대조군 (해제: AUX 위상 grid)" IsChecked="{Binding Document.UseNominalGrid}" AutomationProperties.AutomationId="DocumentNominalGrid"/>
                                                <TextBlock Text="명목 sweep nm/s / 중심 파장 nm / 군굴절률"/>
                                                <UniformGrid Columns="3"><TextBox Text="{Binding Document.NominalSweepNmPerSecond, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding DataContext.CenterWavelengthNm, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.GroupIndex, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                                <CheckBox Content="취득 진행 방향: 파장 증가 (해제: 파장 감소)" IsChecked="{Binding Document.IncreasingWavelength}"/>
                                                <CheckBox Content="5. 상대 거리 단위로 Window/출력 간격 지정" IsChecked="{Binding Document.PhysicalWindow}" AutomationProperties.AutomationId="DocumentPhysicalWindow"/>
                                                <TextBlock Text="창 길이 m / 출력 간격 m / 시작 m / 끝 m"/>
                                                <UniformGrid Columns="4"><TextBox Text="{Binding Document.GaugeMeters, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.HopMeters, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.StartMeters, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.EndMeters, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                                <TextBlock Text="6. 상관 방법 (ZNCC는 평균 제거·정규화·배율 1을 자체 적용)" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{Binding DocumentCorrelations}" SelectedIndex="{Binding DocumentCorrelationIndex}" AutomationProperties.AutomationId="DocumentCorrelation"/>
                                                <TextBlock Text="최대 |이동| pm / 최소 중첩률 / 최고점 제외 반경 pm"/>
                                                <UniformGrid Columns="3"><TextBox Text="{Binding Document.MaximumShiftPm, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.MinimumOverlap, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.PeakExclusionPm, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                                <TextBlock Text="7. 품질 선별: 최소 ZNCC / 최소 최고-차순위 격차"/>
                                                <UniformGrid Columns="2"><TextBox Text="{Binding Document.MinimumZncc, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Document.MinimumSeparation, UpdateSourceTrigger=PropertyChanged}"/></UniformGrid>
                                                <TextBlock Text="B/C/D는 확정된 동일 입력과 mask에 적용합니다. Ref/Signal 구간 번호는 파장 매칭을 보증하지 않습니다. 공통 상대 grid · 기존 sample offset 0/0 필요. Δλ는 상대 기준 후보이며 절대 파장·센싱 입구·strain 교정은 별도입니다." TextWrapping="Wrap" Foreground="#9A3412"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <TextBlock Text="아래 Window 종류·Segment·이동 간격·IFFT padding·상관 정규화도 적용됩니다. 시작값은 출력 524288점입니다. 동일 입력에서 한 항목씩 변경하고 전체 처리 후 현재 값을 기록하세요. 순번 2500~3000은 hop 50에서 FFT bin 125000~150000이며 거리값이 아닙니다." TextWrapping="Wrap" Foreground="#475569" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>
                            <CheckBox Content="261106 노트북 비교 조건 (확정 Raw 직접 처리)" IsChecked="{Binding NotebookReproduction}" AutomationProperties.AutomationId="NotebookRawProcessingMode" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding NotebookModeDescription}" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,8"/>
                            <TextBlock Text="노트북: k 보간 점수 / AUX 시작 offset / 측정 시작 offset" TextWrapping="Wrap"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding NotebookResampledSamples, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Text="{Binding NotebookAuxiliarySliceStart, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Text="{Binding NotebookMeasurementSliceStart, UpdateSourceTrigger=PropertyChanged}"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="편광 채널" />
                            <ComboBox ItemsSource="{Binding PolarizationOptions}" SelectedItem="{Binding SelectedPolarization}" IsEnabled="{Binding UsesLegacyChannelMapping}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Window Filter 종류" />
                            <ComboBox ItemsSource="{Binding WindowFunctions}" SelectedItem="{Binding SelectedWindowFunction}" />
                            <TextBlock Foreground="#FF64748B" Text="Rectangular, Hann(Hanning), Hamming, Blackman 중 선택" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Segment 크기" />
                                    <TextBox Text="{Binding SegmentSize, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Segment 이동 간격" />
                                    <TextBox Text="{Binding SegmentHop, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="IFFT Zero Padding 배율" />
                            <TextBox Text="{Binding ZeroPadFactor, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="최대 Rayleigh Spectral Shift (GHz)" />
                            <TextBox Text="{Binding MaximumSpectralShiftGHz, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Foreground="#FF64748B" TextWrapping="Wrap" Text="Cross Correlation peak는 이 물리 범위 안에서만 찾고 sub-bin 포물선 보간을 적용합니다." />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cross Correlation 배율" />
                            <TextBox Text="{Binding CorrelationScale, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox IsChecked="{Binding NormalizeCorrelation}" Content="Ref×Sig Cross Correlation 정규화" Margin="0,4,0,12" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="보조간섭계 비단조 비율 한계" />
                            <TextBox Text="{Binding MaxNonmonotonicRatio, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="그래프 미리보기 최대 포인트" />
                            <TextBox Text="{Binding MaxPreviewPoints, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Foreground="#FF64748B" TextWrapping="Wrap"
                                       Text="5M 전체 배열은 화면에 직접 전달하지 않으며 최대 10,000 포인트의 최소/최대 윤곽선으로 표시합니다." />

                            <GroupBox Header="거리축 교정 계수" Margin="0,14,0,4">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding UsePhysicalAxes}" Content="FFT와 Strain 결과에 물리축 적용" AutomationProperties.AutomationId="PhysicalAxesEnabled" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="보조간섭계 물리 경로차 (m)" />
                                            <TextBox Text="{Binding AuxiliaryPathDifferenceMeters, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="거리 기하 계수" />
                                            <TextBox Text="{Binding DistanceGeometryFactor, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="보조간섭계 광섬유 Group Index" />
                                    <TextBox Text="{Binding AuxiliaryGroupIndex, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="거리 Offset (m)" />
                                    <TextBox Text="{Binding DistanceOffsetMeters, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="#FFB45309" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="기본 분석은 위 경로차/Group Index를 사용합니다. 문서 단계는 문서 설정의 AUX 지연(us)/ng를 사용하며, 아래 거리 Offset·기하 계수와 공통 strain 계수를 적용합니다. 물리축 ON은 교정 완료를 뜻하지 않습니다." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Strain 환산 계수" Margin="0,4">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="중심 파장 (nm, 확인 필요)" />
                                            <TextBox Text="{Binding CenterWavelengthNm, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Strain 계수 κₑ" />
                                            <TextBox Text="{Binding StrainCoefficient, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Strain 배율" />
                                            <TextBox Text="{Binding StrainScaleFactor, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Strain Offset (με)" />
                                            <TextBox Text="{Binding StrainOffsetMicrostrain, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Foreground="#FFB45309" TextWrapping="Wrap"
                                               Text="기본 중심 파장 1550 nm와 κₑ=0.78은 일반적인 시작값입니다. 실제 Laser와 Fiber 교정값을 확인한 뒤 정량 결과로 사용하세요." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="측정 메모와 기준값" Margin="0,4">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding RestrictToMeasurementRange}"
                                              Content="거리별 Spectral shift 처리를 아래 분석 구간으로 제한" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="분석 시작 거리 (m)" />
                                            <TextBox Text="{Binding AnalysisStartMeters, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="분석 종료 거리 (m)" />
                                            <TextBox Text="{Binding AnalysisEndMeters, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="변형 시작 거리 (m)" />
                                            <TextBox Text="{Binding MeasurementStartMeters, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="변형 종료 거리 (m)" />
                                            <TextBox Text="{Binding MeasurementEndMeters, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="변형구간 길이 (m)" />
                                    <TextBox Text="{Binding DeformationLengthMeters, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Sweep rate (nm/s)" />
                                            <TextBox Text="{Binding SweepRateNmPerSecond, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Sweep range (nm)" />
                                            <TextBox Text="{Binding SweepRangeNm, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Sampling rate (MS/s)" />
                                    <TextBox Text="{Binding SamplingRateMsps, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="#FF64748B" TextWrapping="Wrap"
                                               Text="메모: 측정 5.5~6.5 m, 변형 1.03~1.05 m, Loctite 접착부에서 Peak 손상 가능. 메모의 채널당 2M과 실제 ISF Header 5M이 다르므로 Point 수는 Header를 우선합니다. Sweep range 메모의 단위 nm/s는 nm 여부를 재확인하세요." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GroupBox Grid.Row="2" Header="실행 상태" Margin="0">
                <StackPanel>
                    <ScrollViewer MaxHeight="175" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding UsesLegacyChannelMapping}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                        <TextBlock Text="{Binding ProcessingReadiness}" TextWrapping="Wrap" Margin="0,0,0,7" AutomationProperties.AutomationId="ProcessingQcReadiness">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#0F766E"/><Style.Triggers><DataTrigger Binding="{Binding AllowFailedPhaseQcForDiagnostics}" Value="True"><Setter Property="Foreground" Value="#B45309"/></DataTrigger><DataTrigger Binding="{Binding IsProcessingQcBlocked}" Value="True"><Setter Property="Foreground" Value="#9F1239"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="전체 처리 실행" Command="{Binding RunProcessingCommand}" ToolTip="{Binding ProcessingReadiness}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="RunOfdrProcessing" />
                        <Button Content="취소" Command="{Binding CancelCommand}" Background="#FFB45309" BorderBrush="#FFB45309" />
                    </StackPanel>
                    <TextBlock Text="{Binding AnalysisPurposeSummary}" TextWrapping="Wrap" Foreground="#B45309" Margin="0,0,0,6" AutomationProperties.AutomationId="AnalysisPurpose"/>
                    <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Margin="0,2,0,7" />
                    <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Foreground="#FF334155" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="9" Margin="0,0,0,7" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="{Binding AnalysisPurposeSummary}" TextWrapping="Wrap" Foreground="#9A3412" FontWeight="SemiBold" AutomationProperties.AutomationId="ResultPurposeBanner"/>
        </Border>
        <TabControl Grid.Row="1" AutomationProperties.AutomationId="OfdrResultTabs">
            <TabItem Header="K-linearization">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Padding="10" Margin="6" Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="5">
                            <TextBlock TextWrapping="Wrap" Foreground="#FF1E3A5F"
                                       Text="{Binding KLinearizationFlowDescription}" />
                        </Border>
                        <UniformGrid Columns="2">
                            <GroupBox Header="기준 보조간섭계 Raw">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.KDiagnostics.AuxiliaryRaw.Values}"
                                                     XStartValue="{Binding ProcessingResult.KDiagnostics.AuxiliaryRaw.XStart}" XEndValue="{Binding ProcessingResult.KDiagnostics.AuxiliaryRaw.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="전압 (V)" />
                            </GroupBox>
                            <GroupBox Header="{Binding ReferenceMeanRemovalStageTitle}">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.KDiagnostics.AuxiliaryMeanRemoved.Values}"
                                                     XStartValue="{Binding ProcessingResult.KDiagnostics.AuxiliaryMeanRemoved.XStart}" XEndValue="{Binding ProcessingResult.KDiagnostics.AuxiliaryMeanRemoved.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="전압 (V)" />
                            </GroupBox>
                            <GroupBox Header="기준 Hilbert Analytic 크기">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.KDiagnostics.AnalyticMagnitude.Values}"
                                                     XStartValue="{Binding ProcessingResult.KDiagnostics.AnalyticMagnitude.XStart}" XEndValue="{Binding ProcessingResult.KDiagnostics.AnalyticMagnitude.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="크기" />
                            </GroupBox>
                            <GroupBox Header="기준 Hilbert Wrapped Phase">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.KDiagnostics.WrappedPhase.Values}"
                                                     XStartValue="{Binding ProcessingResult.KDiagnostics.WrappedPhase.XStart}" XEndValue="{Binding ProcessingResult.KDiagnostics.WrappedPhase.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="위상 (rad)" />
                            </GroupBox>
                            <GroupBox Header="기준 Unwrapped 위상">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.KDiagnostics.UnwrappedPhase.Values}"
                                                     XStartValue="{Binding ProcessingResult.KDiagnostics.UnwrappedPhase.XStart}" XEndValue="{Binding ProcessingResult.KDiagnostics.UnwrappedPhase.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="위상 (rad)" />
                            </GroupBox>
                            <GroupBox Header="기준 위상 증가량">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.KDiagnostics.PhaseIncrement.Values}"
                                                     XStartValue="{Binding ProcessingResult.KDiagnostics.PhaseIncrement.XStart}" XEndValue="{Binding ProcessingResult.KDiagnostics.PhaseIncrement.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="위상 변화량 (rad)" />
                            </GroupBox>
                            <GroupBox Header="기준 공통 위상 Grid">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.KDiagnostics.UniformPhaseGrid.Values}"
                                                     XStartValue="{Binding ProcessingResult.KDiagnostics.UniformPhaseGrid.XStart}" XEndValue="{Binding ProcessingResult.KDiagnostics.UniformPhaseGrid.XEnd}"
                                                     XAxisTitle="Normalized-k 샘플" YAxisTitle="위상 (rad)" />
                            </GroupBox>
                            <GroupBox Header="측정 보조간섭계 Raw">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.SignalKDiagnostics.AuxiliaryRaw.Values}"
                                                     XStartValue="{Binding ProcessingResult.SignalKDiagnostics.AuxiliaryRaw.XStart}" XEndValue="{Binding ProcessingResult.SignalKDiagnostics.AuxiliaryRaw.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="전압 (V)" />
                            </GroupBox>
                            <GroupBox Header="측정 Unwrapped 위상">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.SignalKDiagnostics.UnwrappedPhase.Values}"
                                                     XStartValue="{Binding ProcessingResult.SignalKDiagnostics.UnwrappedPhase.XStart}" XEndValue="{Binding ProcessingResult.SignalKDiagnostics.UnwrappedPhase.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="위상 (rad)" />
                            </GroupBox>
                            <GroupBox Header="측정 위상 증가량">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.SignalKDiagnostics.PhaseIncrement.Values}"
                                                     XStartValue="{Binding ProcessingResult.SignalKDiagnostics.PhaseIncrement.XStart}" XEndValue="{Binding ProcessingResult.SignalKDiagnostics.PhaseIncrement.XEnd}"
                                                     XAxisTitle="샘플 번호" YAxisTitle="위상 변화량 (rad)" />
                            </GroupBox>
                            <GroupBox Header="측정 공통 위상 Grid">
                                <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.SignalKDiagnostics.UniformPhaseGrid.Values}"
                                                     XStartValue="{Binding ProcessingResult.SignalKDiagnostics.UniformPhaseGrid.XStart}" XEndValue="{Binding ProcessingResult.SignalKDiagnostics.UniformPhaseGrid.XEnd}"
                                                     XAxisTitle="Normalized-k 샘플" YAxisTitle="위상 (rad)" />
                            </GroupBox>
                            <GroupBox Header="K-linearization QC">
                                <StackPanel Margin="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ProcessingResult.Polarization}" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding ProcessingResult.AuxiliaryId, StringFormat=기준 Aux: {0}}" />
                                    <TextBlock Text="{Binding ProcessingResult.SignalAuxiliaryId, StringFormat=측정 Aux: {0}}" />
                                    <TextBlock Text="{Binding ProcessingResult.ReferenceId, StringFormat=Ref: {0}}" />
                                    <TextBlock Text="{Binding ProcessingResult.SignalId, StringFormat=Sig: {0}}" />
                                    <TextBlock Margin="0,12,0,0" Text="{Binding ProcessingResult.KLinearization.PhaseSpanRadians, StringFormat=기준 위상 범위: {0:G9} rad}" />
                                    <TextBlock Text="{Binding ReferencePhaseIncrementSummary}" />
                                    <TextBlock Text="{Binding ProcessingResult.KLinearization.NonmonotonicRatio, StringFormat=기준 비단조 비율: {0:G9}}" />
                                    <TextBlock Text="{Binding ProcessingResult.KLinearization.AcceptedAnchorCount, StringFormat=기준 사용 앵커 수: {0:N0}}" />
                                    <TextBlock Margin="0,12,0,0" Text="{Binding ProcessingResult.SignalKLinearization.PhaseSpanRadians, StringFormat=측정 위상 범위: {0:G9} rad}" />
                                    <TextBlock Text="{Binding SignalPhaseIncrementSummary}" />
                                    <TextBlock Text="{Binding ProcessingResult.SignalKLinearization.NonmonotonicRatio, StringFormat=측정 비단조 비율: {0:G9}}" />
                                    <TextBlock Text="{Binding ProcessingResult.SignalKLinearization.AcceptedAnchorCount, StringFormat=측정 사용 앵커 수: {0:N0}}" />
                                </StackPanel>
                            </GroupBox>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="S pol">
                <DockPanel Margin="8">
                    <Border DockPanel.Dock="Top" Padding="10" Margin="6" Background="#FFF0FDFA" BorderBrush="#FF99F6E4" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="선택 Segment 번호" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding SelectedSegmentIndex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Segment 그래프 확인" Command="{Binding InspectSegmentCommand}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding PeakDescription}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF134E4A" />
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Padding="10" Margin="6" Background="#FFFFF7ED" BorderBrush="#FFFED7AA" BorderThickness="1" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="처리 순서: 원본 Raw → sweep별 K 보정 → dB 거리 FFT → Segment → Window → IFFT → 제한 범위 Cross Correlation → sub-bin Spectral Shift/Strain" />
                                    <TextBlock Margin="0,5,0,0" Text="{Binding CalibrationSummary}" TextWrapping="Wrap" Foreground="#FF9A3412" />
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="2">
                                <GroupBox Header="화면 1 · Raw 전압 · Sig / Ref">
                                    <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.SignalRaw.Values}" SecondaryValues="{Binding ProcessingResult.ReferenceRaw.Values}"
                                                         XStartValue="{Binding ProcessingResult.SignalRaw.XStart}" XEndValue="{Binding ProcessingResult.SignalRaw.XEnd}"
                                                         XAxisTitle="{Binding ProcessingResult.SignalRaw.XAxisTitle}" YAxisTitle="{Binding ProcessingResult.SignalRaw.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="화면 2 · FFT · K-linearization 전 · Sig / Ref">
                                    <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.PreKSignalSpectrum.Values}" SecondaryValues="{Binding ProcessingResult.PreKReferenceSpectrum.Values}"
                                                         XStartValue="{Binding ProcessingResult.PreKSignalSpectrum.XStart}" XEndValue="{Binding ProcessingResult.PreKSignalSpectrum.XEnd}"
                                                         XAxisTitle="{Binding ProcessingResult.PreKSignalSpectrum.XAxisTitle}" YAxisTitle="{Binding ProcessingResult.PreKSignalSpectrum.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="화면 3 · FFT 거리 데이터 · K-linearization 후 · Sig / Ref">
                                    <controls:SignalPlot Height="320" FftSource="{Binding FftPlotSource}" AutomationProperties.AutomationId="DistanceFftPlot"
                                                         Values="{Binding ProcessingResult.SignalSpectrum.Values}" SecondaryValues="{Binding ProcessingResult.ReferenceSpectrum.Values}"
                                                         XStartValue="{Binding ProcessingResult.SignalSpectrum.XStart}" XEndValue="{Binding ProcessingResult.SignalSpectrum.XEnd}"
                                                         XAxisTitle="{Binding ProcessingResult.SignalSpectrum.XAxisTitle}" YAxisTitle="{Binding ProcessingResult.SignalSpectrum.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="화면 4 · 선택 Segment · K-linearization 후 FFT · Sig / Ref">
                                    <controls:SignalPlot Height="250" Values="{Binding SelectedSegment.SignalSegment.Values}" SecondaryValues="{Binding SelectedSegment.ReferenceSegment.Values}"
                                                         XStartValue="{Binding SelectedSegment.SignalSegment.XStart}" XEndValue="{Binding SelectedSegment.SignalSegment.XEnd}"
                                                         XAxisTitle="{Binding SelectedSegment.SignalSegment.XAxisTitle}" YAxisTitle="{Binding SelectedSegment.SignalSegment.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="화면 5 · Window 적용 Segment · Sig / Ref">
                                    <controls:SignalPlot Height="250" Values="{Binding SelectedSegment.WindowedSignalSegment.Values}" SecondaryValues="{Binding SelectedSegment.WindowedReferenceSegment.Values}"
                                                         XStartValue="{Binding SelectedSegment.WindowedSignalSegment.XStart}" XEndValue="{Binding SelectedSegment.WindowedSignalSegment.XEnd}"
                                                         XAxisTitle="{Binding SelectedSegment.WindowedSignalSegment.XAxisTitle}" YAxisTitle="{Binding SelectedSegment.WindowedSignalSegment.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="화면 6 · IFFT 국부 스펙트럼 · Sig / Ref">
                                    <controls:SignalPlot Height="250" Values="{Binding SelectedSegment.SignalIfft.Values}" SecondaryValues="{Binding SelectedSegment.ReferenceIfft.Values}"
                                                         XStartValue="{Binding SelectedSegment.SignalIfft.XStart}" XEndValue="{Binding SelectedSegment.SignalIfft.XEnd}"
                                                         XAxisTitle="{Binding SelectedSegment.SignalIfft.XAxisTitle}" YAxisTitle="{Binding SelectedSegment.SignalIfft.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="화면 7 · Cross Correlation · 최고 Peak 위치">
                                    <controls:SignalPlot Height="250" Values="{Binding SelectedSegment.Correlation.Values}" MarkerIndices="{Binding CorrelationPeakMarkers}"
                                                         XStartValue="{Binding SelectedSegment.Correlation.XStart}" XEndValue="{Binding SelectedSegment.Correlation.XEnd}"
                                                         XAxisTitle="{Binding SelectedSegment.Correlation.XAxisTitle}" YAxisTitle="{Binding SelectedSegment.Correlation.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="화면 8 · Cross Correlation Peak 확대">
                                    <controls:SignalPlot Height="250" Values="{Binding SelectedSegment.CorrelationZoom.Values}" MarkerIndices="{Binding CorrelationZoomPeakMarkers}"
                                                         XStartValue="{Binding SelectedSegment.CorrelationZoom.XStart}" XEndValue="{Binding SelectedSegment.CorrelationZoom.XEnd}"
                                                         XAxisTitle="{Binding SelectedSegment.CorrelationZoom.XAxisTitle}" YAxisTitle="{Binding SelectedSegment.CorrelationZoom.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="{Binding ProfileStageTitle}">
                                    <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.SpectralShiftProfile.Values}"
                                                         XStartValue="{Binding ProcessingResult.SpectralShiftProfile.XStart}" XEndValue="{Binding ProcessingResult.SpectralShiftProfile.XEnd}"
                                                         XAxisTitle="{Binding ProcessingResult.SpectralShiftProfile.XAxisTitle}" YAxisTitle="{Binding ProcessingResult.SpectralShiftProfile.YAxisTitle}" />
                                </GroupBox>
                                <GroupBox Header="{Binding StrainStageTitle}">
                                    <controls:SignalPlot Height="250" Values="{Binding ProcessingResult.StrainProfile.Values}"
                                                         XStartValue="{Binding ProcessingResult.StrainProfile.XStart}" XEndValue="{Binding ProcessingResult.StrainProfile.XEnd}"
                                                         XAxisTitle="{Binding ProcessingResult.StrainProfile.XAxisTitle}" YAxisTitle="{Binding ProcessingResult.StrainProfile.YAxisTitle}" />
                                </GroupBox>
                            </UniformGrid>

                            <GroupBox Header="선택 그래프 크게 보기" Margin="6,14,6,8">
                                <StackPanel>
                                    <ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding LargeGraphOptions}" SelectedItem="{Binding SelectedLargeGraph}" />
                                    <controls:SignalPlot Height="520" FftSource="{Binding LargeGraphFftSource}" AutomationProperties.AutomationId="LargeGraphPlot"
                                                         Values="{Binding LargeGraphPrimaryValues}" SecondaryValues="{Binding LargeGraphSecondaryValues}"
                                                         MarkerIndices="{Binding LargeGraphMarkers}" XStartValue="{Binding LargeGraphXStart}" XEndValue="{Binding LargeGraphXEnd}"
                                                         XAxisTitle="{Binding LargeGraphXAxisTitle}" YAxisTitle="{Binding LargeGraphYAxisTitle}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="문서 단계 결과 · 변화량 후보와 유사도/판정" AutomationProperties.AutomationId="DocumentResults">
                                <GroupBox.Style><Style TargetType="GroupBox"><Style.Triggers><DataTrigger Binding="{Binding ProcessingResult.DocumentStages}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></GroupBox.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding ProcessingResult.DocumentStages.Summary}" TextWrapping="Wrap" Margin="8" AutomationProperties.AutomationId="DocumentSummary"/>
                                    <GroupBox Header="위치별 strain 환산 · 미교정" AutomationProperties.AutomationId="DocumentStrainResults">
                                        <GroupBox.Style><Style TargetType="GroupBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProcessingResult.DocumentStages.StrainEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></GroupBox.Style>
                                        <StackPanel>
                                            <TextBlock Text="현재 파장·strain 계수로 계산한 환산값입니다. 위 그래프는 내부 조건 통과, 아래는 불합격을 포함한 전체 후보입니다. 표에서 행을 선택하면 해당 위치의 구간·상관 결과를 확인합니다." TextWrapping="Wrap" Margin="8"/>
                                            <controls:SignalPlot Height="220" Values="{Binding ProcessingResult.StrainProfile.Values}" XStartValue="{Binding ProcessingResult.StrainProfile.XStart}" XEndValue="{Binding ProcessingResult.StrainProfile.XEnd}" XAxisTitle="위치 (m; 설정 기반)" YAxisTitle="내부 조건 통과 strain (με; 미교정)"/>
                                            <controls:SignalPlot Height="220" Values="{Binding ProcessingResult.DocumentStages.CandidateStrain.Values}" XStartValue="{Binding ProcessingResult.DocumentStages.CandidateStrain.XStart}" XEndValue="{Binding ProcessingResult.DocumentStages.CandidateStrain.XEnd}" XAxisTitle="위치 (m; 설정 기반)" YAxisTitle="전체 strain 후보 (με; 불합격 포함)"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <controls:SignalPlot Height="230" Values="{Binding ProcessingResult.DocumentStages.AcceptedShift.Values}" XStartValue="{Binding ProcessingResult.DocumentStages.AcceptedShift.XStart}" XEndValue="{Binding ProcessingResult.DocumentStages.AcceptedShift.XEnd}" XAxisTitle="OFDR 상대 거리 (m; 원점 미등록)" YAxisTitle="유효 Δλ 후보 (pm)"/>
                                    <controls:SignalPlot Height="230" Values="{Binding ProcessingResult.DocumentStages.PeakZncc.Values}" SecondaryValues="{Binding ProcessingResult.DocumentStages.PeakSeparation.Values}" XStartValue="{Binding ProcessingResult.DocumentStages.PeakZncc.XStart}" XEndValue="{Binding ProcessingResult.DocumentStages.PeakZncc.XEnd}" XAxisTitle="OFDR 상대 거리 (m)" YAxisTitle="최대 상관 / 피크 분리도"/>
                                    <TextBlock Text="ZNCC는 유사도입니다. 변화량은 피크 위치로 계산합니다. 무효 후보는 위 변화량 그래프에서 제외하며 아래 표에는 원인과 후보값을 보존합니다." TextWrapping="Wrap" Margin="8"/>
                                    <DataGrid ItemsSource="{Binding ProcessingResult.DocumentStages.Points}" SelectedItem="{Binding SelectedDocumentPoint, Mode=TwoWay}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" Height="250" EnableRowVirtualization="True" AutomationProperties.AutomationId="DocumentQualityTable">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="위치 m" Binding="{Binding DistanceMeters, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="창 시작 m" Binding="{Binding WindowStartMeters, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="창 끝 m" Binding="{Binding WindowEndMeters, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="strain 후보 με" Binding="{Binding CandidateStrainMicrostrain, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="통과 strain με" Binding="{Binding AcceptedStrainMicrostrain, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="Δλ 후보 pm" Binding="{Binding CandidateShiftPm, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="lag" Binding="{Binding CandidateLag, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="최고 상관" Binding="{Binding PeakZncc, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="차순위" Binding="{Binding SecondPeak, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="분리도" Binding="{Binding Separation, StringFormat=F4}"/>
                                            <DataGridTextColumn Header="중첩률" Binding="{Binding Overlap, StringFormat=F3}"/>
                                            <DataGridTextColumn Header="판정" Binding="{Binding Status}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="최종 비교" AutomationProperties.AutomationId="FinalComparisonTab">
                <Grid Margin="10" DataContext="{Binding FinalComparison}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <ComboBox Width="190" ItemsSource="{Binding ComparisonModes}" SelectedIndex="{Binding ComparisonModeIndex}" IsEnabled="{Binding ControlsEnabled}" AutomationProperties.AutomationId="ComparisonMode"/>
                        <TextBlock Text="기록명 (선택)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        <TextBox Width="180" Text="{Binding RecordName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ComparisonRecordName"/>
                        <Button Content="현재 값 기록" Command="{Binding RecordCommand}" AutomationProperties.AutomationId="ComparisonRecord"/>
                        <Button Content="Clear" Command="{Binding ClearCommand}" AutomationProperties.AutomationId="ComparisonClear"/>
                        <TextBlock Text="{Binding CountDescription}" VerticalAlignment="Center" Margin="8,0,0,8" FontWeight="SemiBold"/>
                    </WrapPanel>
                    <DockPanel Grid.Row="1" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="저장된 결과 보기 (계산 없음)" Command="{Binding LoadNotebookCommand}" AutomationProperties.AutomationId="LoadNotebookTemperature"/>
                        <TextBox Text="{Binding NotebookResultDirectory, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="완료된 C# 261106 재현 결과 폴더" AutomationProperties.AutomationId="NotebookTemperatureResultDirectory"/>
                    </DockPanel>
                    <TextBlock Grid.Row="2" Text="{Binding RecordReadiness}" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,8"/>
                    <controls:StrainComparisonPlot Grid.Row="3" Entries="{Binding Entries}" Title="{Binding PlotTitle}" XAxisTitle="{Binding XAxisTitle}" YAxisTitle="{Binding YAxisTitle}" Margin="0,0,0,8" AutomationProperties.AutomationId="FinalComparisonPlot"/>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.AutomationId="ComparisonLegend">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="삭제" Width="65">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="삭제" Command="{Binding DeleteCommand}" Padding="6,2" Margin="2"
                                            ToolTip="이 기록만 비교 목록과 그래프에서 삭제합니다."
                                            AutomationProperties.AutomationId="{Binding Number, StringFormat=ComparisonDelete_{0}}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Display Enable" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DisplayEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="체크한 기록만 그래프에 표시합니다."
                                                  AutomationProperties.Name="Display Enable"
                                                  AutomationProperties.AutomationId="{Binding Number, StringFormat=ComparisonDisplayEnable_{0}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="색" Width="35"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="18" Height="5" Background="{Binding LineBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/>
                            <DataGridTextColumn Header="기록명" Binding="{Binding Name}" Width="110"/>
                            <DataGridTextColumn Header="시각" Binding="{Binding RecordedTime}" Width="95"/>
                            <DataGridTextColumn Header="Ref" Binding="{Binding Reference}" Width="*"/>
                            <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" Width="*"/>
                            <DataGridTextColumn Header="품질 / 재현 조건" Binding="{Binding Quality}" Width="145"/>
                            <DataGridTextColumn Header="단계별 처리 조건" Binding="{Binding ProcessingConditions}" Width="260">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding ProcessingConditions}"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="표시 범위" Binding="{Binding Range}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="ComparisonStatus"/>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
    </Grid>
        </TabItem>
        <TabItem Header="Reflectogram · 전력 평균" IsEnabled="{Binding ReflectogramManualEnabled}">
            <controls:ReflectogramView DataContext="{Binding Reflectogram}"/>
        </TabItem>
        <TabItem Header="분포 Δλ / ZNCC · 8쪽" IsEnabled="{Binding ZnccManualEnabled}" AutomationProperties.AutomationId="DistributedComparisonTab">
            <controls:DistributedComparisonView DataContext="{Binding DistributedComparison}"/>
        </TabItem>
    </TabControl>
    </Grid>
</Window>
