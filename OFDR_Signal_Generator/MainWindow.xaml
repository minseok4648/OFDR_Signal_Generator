<Window x:Class="OFDR_Signal_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OFDR_Signal_Generator.Controls"
        mc:Ignorable="d"
        Title="OFDR Test Signal Generator"
        Height="940"
        Width="1580"
        MinHeight="840"
        MinWidth="1340"
        Background="#FFF8FAFC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelText">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF334155" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#FF0F766E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#FF0F766E" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="#FF1E293B" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="#FF0F172A" Text="OFDR Signal Process Lab" />
                <TextBlock Margin="0,8,0,18" Foreground="#FF475569" Text="Configure synthetic settings or load CSV-formatted Raw/Ref beat signals, then inspect each OFDR stage. Sine test mode generates signed Raw/Ref sine signals directly from the configured amplitude, frequency, and phase values." TextWrapping="Wrap" />

                <GroupBox Header="CSV Load">
                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelText}" Text="Raw CSV Path" />
                        <TextBox Text="{Binding RawCsvPath}" IsReadOnly="True" Margin="0,0,0,6" />
                        <TextBlock Foreground="#FF475569" Text="{Binding RawCsvStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding LoadRawCsvCommand}" Content="Load Raw CSV" />
                            <Button Command="{Binding ClearRawCsvCommand}" Background="#FF64748B" BorderBrush="#FF64748B" Content="Clear Raw" />
                        </StackPanel>

                        <Separator Margin="0,8,0,8" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Ref CSV Path" />
                        <TextBox Text="{Binding ReferenceCsvPath}" IsReadOnly="True" Margin="0,0,0,6" />
                        <TextBlock Foreground="#FF475569" Text="{Binding ReferenceCsvStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding LoadReferenceCsvCommand}" Content="Load Ref CSV" />
                            <Button Command="{Binding ClearReferenceCsvCommand}" Background="#FF64748B" BorderBrush="#FF64748B" Content="Clear Ref" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Acquisition Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Sample Count" />
                            <TextBox Text="{Binding SampleCount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Sample Spacing" />
                            <TextBox Text="{Binding SampleSpacing, UpdateSourceTrigger=PropertyChanged, StringFormat=F8}" />
                        </StackPanel>
                        <StackPanel Grid.ColumnSpan="2" Margin="0,74,0,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Random Seed" />
                            <TextBox Text="{Binding RandomSeed, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Raw Signal Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Raw Noise" />
                            <TextBox Text="{Binding RawNoiseLevel, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Raw Attenuation" />
                            <TextBox Text="{Binding RawAttenuation, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <TextBlock Style="{StaticResource LabelText}" Text="Raw Baseline Offset" />
                            <TextBox Text="{Binding RawBaselineOffset, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Reference Signal Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,10,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Reference Amplitude" />
                            <TextBox Text="{Binding ReferenceAmplitude, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Reference Delay" />
                            <TextBox Text="{Binding ReferenceDelaySamples, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,10,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Reference Width" />
                            <TextBox Text="{Binding ReferenceWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Reference Noise" />
                            <TextBox Text="{Binding ReferenceNoiseLevel, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Reference Baseline" />
                            <TextBox Text="{Binding ReferenceBaselineOffset, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Phase Shift (deg)" />
                            <TextBox Text="{Binding ReferencePhaseShiftDegrees, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Sine Test Signal Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding UseRawSineSignal}" Content="Use Raw Sine" Margin="0,0,10,8" />
                        <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding UseReferenceSineSignal}" Content="Use Ref Sine" Margin="0,0,0,8" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Raw Sine Amplitude" />
                            <TextBox Text="{Binding RawSineAmplitude, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Ref Sine Amplitude" />
                            <TextBox Text="{Binding ReferenceSineAmplitude, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Raw Sine Frequency (cycles/window)" />
                            <TextBox Text="{Binding RawSineFrequency, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Ref Sine Frequency (cycles/window)" />
                            <TextBox Text="{Binding ReferenceSineFrequency, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Raw Sine Phase (deg)" />
                            <TextBox Text="{Binding RawSinePhaseDegrees, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Ref Sine Phase (deg)" />
                            <TextBox Text="{Binding ReferenceSinePhaseDegrees, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="FFT Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Segment IFFT Zero Pad Factor" />
                            <TextBox Text="{Binding FftZeroPadFactor, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Windowing" />
                            <CheckBox IsChecked="{Binding UseHannWindow}" Content="Use Hann Window" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Segmentation Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Segment Size" />
                            <TextBox Text="{Binding SegmentSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Segment Hop" />
                            <TextBox Text="{Binding SegmentHop, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="X-Corr Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="X-Corr Scale" />
                            <TextBox Text="{Binding ConjugateMultiplyScale, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Normalization" />
                            <CheckBox IsChecked="{Binding NormalizeConjugateMultiply}" Content="Normalize X-Corr" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Final Metric Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="IFFT Feature Metric" />
                            <ComboBox ItemsSource="{Binding FinalMetricModes}" SelectedItem="{Binding SelectedFinalMetricMode}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="Smoothing Window" />
                            <TextBox Text="{Binding FinalSmoothingWindow, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="Peak Threshold Ratio" />
                            <TextBox Text="{Binding PeakThresholdRatio, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Synthetic Raw Segment IFFT Shift Events">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding AddEventCommand}" Content="Add Event" />
                            <Button Command="{Binding RemoveEventCommand}" Background="#FFB45309" BorderBrush="#FFB45309" Content="Remove Selected" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ReflectionEvents}" SelectedItem="{Binding SelectedReflectionEvent}" MinHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Target Segment" Binding="{Binding PositionIndex, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="Shift Bins" Binding="{Binding Amplitude, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Width="*" />
                                <DataGridTextColumn Header="Reserved" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}" Width="*" Visibility="Collapsed" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GroupBox Grid.Row="1" Header="Actions" Margin="0,14,0,0">
                <StackPanel>
                    <Button Command="{Binding GenerateSignalCommand}" Content="Prepare Active Raw + Ref Data" />
                    <Button Command="{Binding RunPipelineCommand}" Background="#FF1D4ED8" BorderBrush="#FF1D4ED8" Content="Run OFDR Pipeline" />
                    <Button Command="{Binding ExportReconstructedRawCsvCommand}" Background="#FF7C3AED" BorderBrush="#FF7C3AED" Content="Export Reconstructed Raw CSV" />
                    <Button Command="{Binding ResetDefaultsCommand}" Background="#FF475569" BorderBrush="#FF475569" Content="Reset Defaults" />
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid Grid.Column="2">
            <TabControl Background="Transparent">
                <TabItem Header="Stages">
                    <Border Padding="12" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="12" Margin="0,0,0,12" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock FontWeight="SemiBold" Foreground="#FF0F172A" Text="Segment Inspector" />
                                        <TextBlock Margin="0,6,0,0" Foreground="#FF475569" Text="{Binding SelectedSegmentSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Width="320">
                                        <TextBlock Style="{StaticResource LabelText}" Text="Selected Segment" />
                                        <ComboBox ItemsSource="{Binding SegmentLabels}" SelectedIndex="{Binding SelectedSegmentIndex}" MinWidth="300" Margin="0,0,0,8" />
                                        <TextBlock Style="{StaticResource LabelText}" Text="X-Corr View" />
                                        <ComboBox ItemsSource="{Binding ConjMulViewModes}" SelectedItem="{Binding SelectedConjMulViewMode}" MinWidth="300" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TabControl Grid.Row="1" ItemsSource="{Binding StageResults}" SelectedItem="{Binding SelectedStage}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Description}" Foreground="#FF475569" TextWrapping="Wrap" />
                                            <ItemsControl Grid.Row="1" Margin="0,12,0,12" ItemsSource="{Binding Metrics}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,10,10" Padding="10" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10">
                                                            <StackPanel Width="120">
                                                                <TextBlock FontSize="12" Foreground="#FF64748B" Text="{Binding Name}" />
                                                                <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#FF0F172A" Text="{Binding Value}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <controls:SignalPlot Grid.Row="2" MinHeight="320" Values="{Binding Samples}" MarkerIndices="{Binding MarkerIndices}" XAxisTitle="{Binding XAxisTitle}" YAxisTitle="{Binding YAxisTitle}" XStartValue="{Binding XStartValue}" XEndValue="{Binding XEndValue}" />
                                            <Border Grid.Row="3"
                                                    Margin="0,12,0,0"
                                                    Padding="12"
                                                    Background="#FFF8FAFC"
                                                    BorderBrush="#FFE2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Visibility="{Binding DataContext.IsCorrelationInspectorVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Foreground="#FF0F172A" Text="Lag Overlap Inspector" />
                                                    <TextBlock Margin="0,6,0,10" Foreground="#FF475569" Text="{Binding DataContext.SelectedCorrelationLagSummary, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FF334155" Text="k (Lag)" />
                                                        <Slider Grid.Column="1"
                                                                Minimum="{Binding DataContext.SelectedCorrelationLagMinimum, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Maximum="{Binding DataContext.SelectedCorrelationLagMaximum, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Value="{Binding DataContext.SelectedCorrelationLag, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                IsSnapToTickEnabled="True"
                                                                TickFrequency="1" />
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF0F172A" FontWeight="SemiBold" Text="{Binding DataContext.SelectedCorrelationLag, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='k = {0}'}" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                            <Rectangle Width="12" Height="12" Fill="#FF38BDF8" Margin="0,0,6,0" />
                                                            <TextBlock Foreground="#FF334155" Text="Raw Segment IFFT" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="12" Height="12" Fill="#FFFB923C" Margin="0,0,6,0" />
                                                            <TextBlock Foreground="#FF334155" Text="Shifted Ref Segment IFFT" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <controls:SignalPlot Grid.Row="4" MinHeight="240"
                                                                 Margin="0,12,0,0"
                                                                 Visibility="{Binding DataContext.IsCorrelationInspectorVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                 Values="{Binding DataContext.CorrelationOverlayRawSamples, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 SecondaryValues="{Binding DataContext.CorrelationOverlayReferenceSamples, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 XAxisTitle="IFFT Sample Index"
                                                                 YAxisTitle="Magnitude"
                                                                 XStartValue="0"
                                                                 XEndValue="{Binding DataContext.CorrelationOverlayXEndValue, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </Grid>
                    </Border>
                </TabItem>

                <TabItem Header="Ground Truth vs Detection">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="12" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="14">
                            <TextBlock Foreground="#FF334155" Text="For loaded Raw CSV data there is no built-in ground truth, so the match table is meaningful only for synthetic raw signals." TextWrapping="Wrap" />
                        </Border>

                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Grid.Column="0" Header="Ground Truth Events" Margin="0,0,8,0">
                                <DataGrid ItemsSource="{Binding ReflectionEvents}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Target Segment" Binding="{Binding PositionIndex}" Width="*" />
                                        <DataGridTextColumn Header="Shift Bins" Binding="{Binding Amplitude, StringFormat=F0}" Width="*" />
                                        <DataGridTextColumn Header="Reserved" Binding="{Binding Width, StringFormat=F0}" Width="*" Visibility="Collapsed" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="Detected Events" Margin="8,0,0,0">
                                <DataGrid ItemsSource="{Binding DetectedEvents}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Index" Binding="{Binding PositionIndex}" Width="*" />
                                        <DataGridTextColumn Header="Amplitude" Binding="{Binding Amplitude, StringFormat=F3}" Width="*" />
                                        <DataGridTextColumn Header="Distance" Binding="{Binding Distance, StringFormat=F6}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>

                        <GroupBox Grid.Row="2" Header="Event Match Table" Margin="0">
                            <DataGrid ItemsSource="{Binding MatchResults}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*" />
                                    <DataGridTextColumn Header="Detected" Binding="{Binding Detected}" Width="*" />
                                    <DataGridTextColumn Header="Error Samples" Binding="{Binding ErrorSamples}" Width="*" />
                                    <DataGridTextColumn Header="Error Distance" Binding="{Binding ErrorDistance}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>


















