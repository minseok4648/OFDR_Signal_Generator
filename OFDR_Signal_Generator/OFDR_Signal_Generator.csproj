  <!--
    This legacy WPF project does not reliably receive PackageReference runtime
    assets through the SDK-style Core project reference. Keep the MKL packages
    here as direct application dependencies so the provider and native runtime
    are deployed with the executable.
  -->
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="MathNet.Numerics.Providers.MKL" Version="5.0.0" />
    <PackageReference Include="MathNet.Numerics.MKL.Win-x64" Version="3.0.0" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="DeployMathNetMklNativeRuntime" AfterTargets="Build">
    <ItemGroup>
      <MathNetMklNative Include="$(TargetDir)runtimes\win-x64\native\libiomp5md.dll" Condition="Exists('$(TargetDir)runtimes\win-x64\native\libiomp5md.dll')" />
      <MathNetMklNative Include="$(TargetDir)runtimes\win-x64\native\libMathNetNumericsMKL.dll" Condition="Exists('$(TargetDir)runtimes\win-x64\native\libMathNetNumericsMKL.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(MathNetMklNative)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(TargetDir)MathNet.Numerics.Providers.MKL.dll')" Text="MathNet MKL provider deployment failed: MathNet.Numerics.Providers.MKL.dll is missing from $(TargetDir)." />
    <Error Condition="!Exists('$(TargetDir)libMathNetNumericsMKL.dll')" Text="MathNet MKL native runtime deployment failed: libMathNetNumericsMKL.dll is missing from $(TargetDir)." />
  </Target>
