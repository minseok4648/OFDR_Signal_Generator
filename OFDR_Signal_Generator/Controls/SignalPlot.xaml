<UserControl x:Class="OFDR_Signal_Generator.Controls.SignalPlot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220"
             MinWidth="300"
             ToolTip="휠: 확대/축소 · 드래그: 영역 확대 · 우클릭: 이전 · 더블클릭: 전체">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="FftRangePanel" Visibility="Collapsed" Margin="4,0,4,4">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="표시 범위 " VerticalAlignment="Center"/>
                <TextBox x:Name="FftRangeStart" Width="80" Margin="2" ToolTip="시작 거리(m) 또는 FFT bin" AutomationProperties.AutomationId="FftRangeStart"/>
                <TextBlock Text="~" VerticalAlignment="Center"/>
                <TextBox x:Name="FftRangeEnd" Width="80" Margin="2" ToolTip="끝 거리(m) 또는 FFT bin" AutomationProperties.AutomationId="FftRangeEnd"/>
                <Button Content="범위 적용" Click="ApplyFftRange_OnClick" Padding="6,2" Margin="2" AutomationProperties.AutomationId="ApplyFftRange"/>
                <Button Content="Y 자동" Click="AutoY_OnClick" Padding="6,2" Margin="2"/>
                <TextBlock x:Name="FftRangeUnit" VerticalAlignment="Center" Margin="4,0"/>
            </WrapPanel>
            <TextBlock x:Name="FftResolutionText" FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
        </StackPanel>
    <Border Grid.Row="1" Background="#FF0F172A"
            BorderBrush="#FFCBD5E1"
            BorderThickness="1"
            CornerRadius="10"
            Padding="4">
        <Grid>
            <Canvas x:Name="PlotCanvas"
                    SizeChanged="PlotCanvas_OnSizeChanged"
                    ClipToBounds="True"
                    Background="Transparent"
                    MouseMove="PlotCanvas_OnMouseMove"
                    MouseLeave="PlotCanvas_OnMouseLeave"
                    MouseLeftButtonDown="PlotCanvas_OnMouseLeftButtonDown"
                    MouseLeftButtonUp="PlotCanvas_OnMouseLeftButtonUp"
                    MouseWheel="PlotCanvas_OnMouseWheel"
                    MouseRightButtonDown="PlotCanvas_OnMouseRightButtonDown"
                    LostMouseCapture="PlotCanvas_OnLostMouseCapture" />

            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Stroke="#FF7DD3FC"
                       Fill="#337DD3FC"
                       StrokeThickness="1"
                       RadiusX="2"
                       RadiusY="2"
                       IsHitTestVisible="False"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0">
                <Button Content="한 단계 축소"
                        Click="ZoomOutButton_OnClick"
                        Padding="10,4"
                        Margin="0,0,6,0"
                        Background="#FF1E293B"
                        BorderBrush="#FF475569"
                        Foreground="White" />
                <Button Content="전체 보기"
                        Click="ResetZoomButton_OnClick"
                        Padding="10,4"
                        Background="#FF1E293B"
                        BorderBrush="#FF475569"
                        Foreground="White" />
            </StackPanel>

            <Border x:Name="HoverPopup"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#E6000000"
                    BorderBrush="#FF7DD3FC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="HoverText"
                           Foreground="White"
                           FontSize="12" />
            </Border>

            <TextBlock x:Name="InteractionHintText"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="90,8,0,0"
                       Foreground="#FF94A3B8"
                       FontSize="11"
                       Text="휠: 확대/축소 · 드래그: 영역 확대" />

            <TextBlock x:Name="EmptyStateText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FF94A3B8"
                       FontSize="14"
                       Text="표시할 데이터가 없습니다." />
        </Grid>
    </Border>
    </Grid>
</UserControl>
