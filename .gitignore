# Code-only repository: ignore files by default, then allow source/build inputs.
*
!*/
!.gitignore
!.gitattributes
!.editorconfig
!AGENTS.md

# Application, test and native source code.
!*.cs
!*.xaml
!*.c
!*.cpp
!*.h
!*.hpp

# Solution/project files, build configuration and application resources.
!*.sln
!*.slnx
!*.slnf
!*.csproj
!*.props
!*.targets
!*.config
!*.resx
!*.settings
!*.ico
!*.ruleset
!*.runsettings
!global.json
!NuGet.Config
!*.yml
!*.yaml
!/OFDR_Signal_Generator/Assets/**
!/OFDR_Signal_Generator/Resources/**

# Executable tools and reproducible processing configuration/schema inputs.
!*.ps1
!*.py
!*.sh
!*.cmd
!*.bat
!/harness/configs/**/*.json
!/harness/schemas/**/*.json

# Generated/local directories override all source-file exceptions above.
.vs/
.idea/
.serena/
[Bb]in/
[Oo]bj/
packages/
build_verify*/
[Tt]est[Rr]esults/
__pycache__/
.pytest_cache/
.venv/
venv/
.analysis_deps/
.analysis_cache/
/docs/
/harness/datasets/
/harness/experiments/
/harness/results/

# Measurement data, exports and binaries are never source/build inputs.
*.[iI][sS][fF]
*.[cC][sS][vV]
*.bin
*.exe
*.dll
*.pdb
*.exe.config
*.dll.config
*.nupkg
*.snupkg
*.partial
*.backup
*.user
*.suo
*.cache
*.log
*.trx
*.coverage
*.coveragexml
