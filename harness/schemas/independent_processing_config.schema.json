{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OFDR independent Aux/Ref/Sig processing config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "MaxAuxNonmonotonicRatio",
    "WindowFunction",
    "SegmentSize",
    "SegmentHop",
    "SegmentIfftZeroPadFactor",
    "CrossCorrelationScale",
    "NormalizeCrossCorrelation",
    "MaxPreviewPoints",
    "UsePhysicalAxes",
    "AuxiliaryPathDifferenceMeters",
    "DistanceGeometryFactor",
    "DistanceOffsetMeters",
    "CenterWavelengthNm",
    "StrainCoefficient",
    "StrainScaleFactor",
    "StrainOffsetMicrostrain",
    "MeasurementStartMeters",
    "MeasurementEndMeters",
    "DeformationLengthMeters",
    "SweepRangeNm",
    "SweepRateNmPerSecond",
    "SamplingRateSamplesPerSecond",
    "RestrictToMeasurementRange",
    "AuxiliaryGroupIndex",
    "MaximumSpectralShiftGHz",
    "AnalysisStartMeters",
    "AnalysisEndMeters",
    "FftDbFloor"
  ],
  "properties": {
    "SchemaVersion": { "const": 3 },
    "MaxAuxNonmonotonicRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "WindowFunction": { "enum": ["Rectangular", "Hann", "Hamming", "Blackman"] },
    "SegmentSize": { "type": "integer", "minimum": 2 },
    "SegmentHop": { "type": "integer", "minimum": 1 },
    "SegmentIfftZeroPadFactor": { "type": "integer", "minimum": 1 },
    "CrossCorrelationScale": { "type": "number" },
    "NormalizeCrossCorrelation": { "type": "boolean" },
    "MaxPreviewPoints": { "type": "integer", "minimum": 16, "maximum": 10000 },
    "UsePhysicalAxes": { "type": "boolean" },
    "AuxiliaryPathDifferenceMeters": { "type": "number", "exclusiveMinimum": 0 },
    "DistanceGeometryFactor": { "type": "number", "exclusiveMinimum": 0 },
    "DistanceOffsetMeters": { "type": "number" },
    "CenterWavelengthNm": { "type": "number", "exclusiveMinimum": 0 },
    "StrainCoefficient": { "type": "number", "exclusiveMinimum": 0 },
    "StrainScaleFactor": { "type": "number", "not": { "const": 0 } },
    "StrainOffsetMicrostrain": { "type": "number" },
    "MeasurementStartMeters": { "type": "number" },
    "MeasurementEndMeters": { "type": "number" },
    "DeformationLengthMeters": { "type": "number", "exclusiveMinimum": 0 },
    "SweepRangeNm": { "type": "number", "exclusiveMinimum": 0 },
    "SweepRateNmPerSecond": { "type": "number", "exclusiveMinimum": 0 },
    "SamplingRateSamplesPerSecond": { "type": "number", "exclusiveMinimum": 0 },
    "RestrictToMeasurementRange": { "type": "boolean" },
    "AuxiliaryGroupIndex": { "type": "number", "exclusiveMinimum": 0 },
    "MaximumSpectralShiftGHz": { "type": "number", "exclusiveMinimum": 0 },
    "AnalysisStartMeters": { "type": "number" },
    "AnalysisEndMeters": { "type": "number" },
    "FftDbFloor": { "type": "number", "exclusiveMaximum": 0 }
  }
}
